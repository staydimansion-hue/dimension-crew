# 실제 배포 주소 (Railway 등). 슬랙 알림 안의 "관리자 승인" 링크처럼
# 외부로 나가는 링크를 만들 때 씀. 요청 헤더에서 유추하면 배포 환경에
# 따라 내부 주소(예: http://localhost:8080)로 잘못 잡힐 수 있어서
# 반드시 직접 지정한다. 마지막에 슬래시(/) 없이.
APP_URL=https://dimension-crew-production.up.railway.app

# Supabase (Settings > API 에서 확인)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 세션 서명용 비밀키 (각각 다른 임의의 긴 문자열, 예: openssl rand -hex 32 또는
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_JWT_SECRET=
STAFF_JWT_SECRET=

# Google 서비스 계정 (Google Cloud Console에서 발급)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=197I75Q1xujRIPZcK_7fUhtvnyZyGTXFzQVAxn8mhPYQ
GOOGLE_SHEETS_TAB_NAME=QR출퇴근기록
GOOGLE_SHEETS_PAYROLL_TAB_NAME=매입)인건비

# 슬랙 봇 토큰 (아래 여러 기능이 공용으로 사용: 객실 청소 완료·출퇴근 알림, 운영방 체크리스트)
SLACK_BOT_TOKEN=
SLACK_ROOM_CHANNEL_ID=

# 슬랙 (운영방 일일 체크리스트 봇 — SLACK_BOT_TOKEN에 chat:write, channels:history 또는
# groups:history 권한 필요)
SLACK_OPERATIONS_CHANNEL_ID=

# 슬랙 (인건비 월별 자동 알림)
SLACK_SIGNING_SECRET=
SLACK_MANAGER_USER_ID=
SLACK_PAYROLL_CHANNEL_ID=

# 공공데이터포털 특일 정보 API (공휴일 판단용, 인건비 알림 날짜 계산에 사용)
DATA_GO_KR_HOLIDAY_API_KEY=

# 크론 엔드포인트(/api/cron/*)가 공용으로 사용하는 비밀 토큰 (아무 임의의 긴 문자열, 예: openssl rand -hex 32)
CRON_SECRET=

# Claude API 키 (운영방 체크리스트 진행 요약/재계획 AI 기능용, https://console.anthropic.com)
ANTHROPIC_API_KEY=
